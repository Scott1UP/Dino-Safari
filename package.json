{
  "name": "dino-safari",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "art": "node --env-file=.env.local scripts/art.mjs",
    "audio": "node --env-file=.env.local scripts/audio.mjs",
    "icons": "node scripts/icons.mjs",
    "android:sync": "npm run build && cap sync android",
    "android:apk": "npm run android:sync && cd android && JAVA_HOME=\"${JAVA_HOME:-/opt/homebrew/opt/openjdk@21}\" ./gradlew assembleRelease"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.2",
    "@types/three": "^0.187.0",
    "sharp": "^0.35.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/core": "^8.6.2",
    "@fontsource/fredoka": "^5.3.0",
    "lucide": "^1.76.0",
    "three": "^0.187.0"
  }
}
